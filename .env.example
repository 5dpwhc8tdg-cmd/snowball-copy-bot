# ============================================================
#  Snowball Copy Bot — настройки
#  Скопируйте файл в .env и заполните своими значениями:
#      cp .env.example .env
#  Всё, что закомментировано «#», можно не трогать.
# ============================================================

# --- Что отслеиваем -----------------------------------------
PORTFOLIO_ID=ukbRjaXjfg
PORTFOLIO_TITLE=Облигационные фантазии

# Как часто проверять новый сделки, секунды (минимум 60)
POLL_INTERVAL=300

# --- Куда присылать: Telegram --------------------------------
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш chat_id (узнать: напишите боту @userinfobot). Можно несколько через запятую.
TELEGRAM_CHAT_ID=
# Разрешить команды /status /last /mute (бот будет слушать getUpdates)
TELEGRAM_COMMANDS=1

# --- Куда присылать: MAX (max.ru) ---------------------------
# Токен бота: business.max.ru → Чат-боты → ⋮ → Настройки
MAX_BOT_TOKEN=
# ID пользователя, которому писать (нужен, если пишем в личку)
MAX_USER_ID=
# либо ID чата/канала
MAX_CHAT_ID=
MAX_API_BASE=https://platform-api2.max.ru

# Печатать сообщения в консоль (полезно при первом запуске)
CONSOLE_OUTPUT=1

# --- Что присылать ------------------------------------------
# buy | sell | both
ONLY_TYPE=both
# Не присылать сделки меньше этой суммы, ₽ (0 = все)
MIN_AMOUNT=0
# Тикеры, которые игнорируем, через запятую
IGNORE_TICKERS=
# Присылать купоны/начисления (тип 5)
INCLUDE_INCOME=0
# Пересчёт размера сделки под ваш капитал: 0.1 = в 10 раз меньше.
# 0 = не показывать
COPY_SCALE=0
# Показывать в уведомлениях данные о бумаге (цена/номинал, доходность, рейтинг)
ASSET_DETAILS=1

# Первый запуск: baseline — запомнить историю и молчать,
# last:5 — прислать 5 последних сделок для проверки
FIRST_RUN=baseline

# --- Служебное ----------------------------------------------
DB_PATH=data/bot.sqlite3
LOG_PATH=data/bot.log
TZ_NAME=Europe/Moscow
DEBUG=0

# --- Доступность неквалу ------------------------------------
# Проверять по MOEX + рейтингу, нужен ли тест (и писать вердикт в сообщении)
CHECK_QUALIFIED=1
# 1 = присылать ТОЛЬКО бумаги, которые неквал может купить без теста
# (продажи приходят всегда)
ONLY_NO_TEST=0

# --- Ваш капитал и пересчёт размера -------------------------
# Ваш капитал, ₽ — от него считаются размеры сделок и сигналов
MY_CAPITAL=100000
# Капитал владельца портфеля, ₽ (для расчёта масштаба)
OWNER_CAPITAL=7000000
# Максимум на одну идею, % капитала
MY_MAX_POSITION_PCT=10
# Резерв, % капитала (не вкладываем)
MY_RESERVE_PCT=20
# Сколько дней держим идею (по разбору его сделок максимум дают 1-3 дня)
HOLD_DAYS=2
# 1 = присылать только выпуски с рейтингом A+ (покупка без теста неквала)
ONLY_RATING_A_PLUS=0
